# Живая база магазина и всё, что из неё растёт.  В репозиторий не едет
# ничего с настоящими продажами: там имена кассиров, выручка и остатки.
store.db
store.db-wal
store.db-shm
store.db.before-*
backup/
data/

# Записки серверу от самого себя, для лаунчера.  На проданной кассе они
# лежат в data/ и уже игнорируются строкой выше, но dev-запуск без POS_DB
# кладёт их прямо в корень репозитория.
update-requested
minimize-requested

# Настройки конкретной кассы: имя принтера, название магазина, пин хозяина.
settings.json
pack/shop.json

# Выгрузки из старой программы и отчёты.
*.xlsx
tools/*.txt

# Сборка: скачанный Python, обновление Windows, готовые архивы.
pack/cache/
pack/dist/

__pycache__/
*.pyc
