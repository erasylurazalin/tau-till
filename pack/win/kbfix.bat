@echo off
rem Запасной путь на случай, если библиотек рядом с программой не хватило.
rem Ставит то самое обновление Windows, которого не было на кассе.
chcp 866 >nul
title Обновление Windows для кассы
cls
echo.
echo    ==================================================
echo       ОБНОВЛЕНИЕ WINDOWS ДЛЯ КАССЫ
echo    ==================================================
echo.
echo    Запускайте это ТОЛЬКО если установка кассы
echo    написала, что Python не запускается.
echo.
echo    Сейчас откроется окно установки обновления
echo    от Microsoft. В нём нужно нажать "Да",
echo    дождаться конца и перезагрузить компьютер.
echo.
echo    После перезагрузки снова запустите
echo    УСТАНОВИТЬ КАССУ.bat
echo.
wusa "%~dp0Windows6.1-KB2999226-x64.msu"
echo.
echo    Окно установки закрылось.
echo.
echo    Если обновление установилось, перезагрузите
echo    компьютер и повторите установку кассы.
echo.
echo    Если написано, что обновление уже установлено
echo    на этом компьютере, значит дело не в нём.
echo    Позвоните тому, кто настраивает кассу.
echo.
timeout /t 90 /nobreak >nul
exit /b 0
